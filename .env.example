# All of these can also be set in the app (gear icon, top right), which overrides them per browser.

# ComfyUI server (local instance or tunnel). Proxied by the app at /comfy.
COMFY_URL=http://127.0.0.1:8188

# Optional: a ComfyUI server whose backend already has the Comfy API key. No key is sent to it, and the
# Settings dialog doesn't ask for one.
# COMFY_KEYLESS_URL=http://your-comfyui-host:8188

# Optional: Comfy Cloud API key, used when "Comfy Cloud" is selected and no key was entered in Settings.
# COMFY_CLOUD_API_KEY=

# Street View (WhatIfStreet). Server-side only.
# GOOGLE_MAPS_API_KEY=

# Optional: direct WebSocket for live step progress (browser must reach it).
# Without it the UI polls /history and shows elapsed time only.
# NEXT_PUBLIC_COMFY_WS_URL=ws://127.0.0.1:8188/ws

# --- Microsoft Entra ID single sign-on ---
# Redirect URI to register on the app registration (Web platform): <origin>/api/auth/callback
#   e.g. http://127.0.0.1:3000/api/auth/callback
AZURE_AD_TENANT_ID=b5832170-02c3-46fd-b5bf-d0cba82abe11
AZURE_AD_CLIENT_ID=555519be-ceb9-4fe0-ab19-a20197261791
# Create under Certificates & secrets. Server-side only.
# AZURE_AD_CLIENT_SECRET=
# Signs the session cookie. At least 32 characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# AUTH_SECRET=
# Public origin when behind a tunnel/reverse proxy (defaults to the request origin).
# AUTH_URL=https://scenesplice.example.com
# Local development only: skip sign-in entirely.
# AUTH_DISABLED=true
