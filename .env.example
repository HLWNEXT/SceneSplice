# All of these can also be set in the app (gear icon, top right), which overrides them per browser.

# ComfyUI server (local instance or tunnel). Proxied by the app at /comfy.
COMFY_URL=http://172.16.34.152:8188

# Optional: Comfy Cloud API key, used when "Comfy Cloud" is selected and no key was entered in Settings.
# COMFY_CLOUD_API_KEY=

# Street View (WhatIfStreet). Server-side only.
# GOOGLE_MAPS_API_KEY=

# Optional: direct WebSocket for live step progress (browser must reach it).
# Without it the UI polls /history and shows elapsed time only.
# NEXT_PUBLIC_COMFY_WS_URL=ws://172.16.34.152:8188/ws
