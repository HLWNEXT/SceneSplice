  "8": { "class_type": "ReferenceLatent", "inputs": { "conditioning": ["7", 0], "latent": ["6", 0] }, "_meta": { "title": "Reference = as-built" } },
  "9": { "class_type": "FluxGuidance", "inputs": { "conditioning": ["8", 0], "guidance": 2.5 }, "_meta": { "title": "Guidance" } },
