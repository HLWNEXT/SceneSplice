{
  "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "flux1-dev-kontext_fp8_scaled.safetensors", "weight_dtype": "default" }, "_meta": { "title": "FLUX Kontext model" } },
  "2": { "class_type": "DualCLIPLoader", "inputs": { "clip_name1": "clip_l.safetensors", "clip_name2": "t5xxl_fp8_e4m3fn_scaled.safetensors", "type": "flux", "device": "default" }, "_meta": { "title": "FLUX text encoders" } },
  "3": { "class_type": "VAELoader", "inputs": { "vae_name": "ae.safetensors" }, "_meta": { "title": "FLUX VAE" } },
  "4": { "class_type": "LoadImage", "inputs": { "image": "as-built.png" }, "_meta": { "title": "INPUT: as-built image" } },
